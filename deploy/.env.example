# এটা কপি করে .env বানান:  cp .env.example .env
# .env কখনো git-এ যাবে না — এতে গোপন চাবি থাকে।

# যে ঠিকানায় অ্যাপ খুলবে। DNS-এর A রেকর্ড VPS-এর IP-র দিকে থাকতে হবে।
DOMAIN=deen-together.example.com

# ডেটাবেসের পাসওয়ার্ড — লম্বা, এলোমেলো। বানাতে:  openssl rand -hex 24
POSTGRES_PASSWORD=

# পুশ নোটিফিকেশনের চাবি — আগের (Vercel-এর) মানগুলোই হুবহু বসান।
# নতুন চাবি দিলে সবার ফোনে নোটিফিকেশন আবার চালু করতে হবে।
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:apnar@email.com

# cron যেন বাইরের কেউ চালাতে না পারে
CRON_SECRET=

# (ইচ্ছা হলে) নিজের db-র বদলে Neon-এই থাকতে চাইলে তার ঠিকানা। ফাঁকা রাখলে নিজের db।
DATABASE_URL=

# সার্ভারের 127.0.0.1-এর কোন পোর্টে অ্যাপ খুলবে — অন্য সাইট থাকলে ফাঁকা একটা বেছে নিন
APP_PORT=3000

# 80/443 খালি থাকলে (VPS-এ আর কোনো ওয়েব সার্ভার নেই) নিচের লাইনটা দিন —
# তখন সাথের Caddy নিজেই HTTPS সামলাবে। আগে থেকে nginx/Caddy থাকলে ফাঁকা রাখুন।
COMPOSE_PROFILES=
