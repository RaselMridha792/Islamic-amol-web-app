# Neon-এর connection string। neon.tech → প্রজেক্ট → Connection string → "Pooled connection"
# শুধু সার্ভারে পড়া হয়, ব্রাউজারে কখনো যায় না। এটা না দিলে অ্যাপ শুধু ব্রাউজারেই হিসাব রাখবে।
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Push notification এর চাবি। বানাতে:  node scripts/makeVapid.mjs
# public key ব্রাউজারে যায় (তাই NEXT_PUBLIC_), private key শুধু সার্ভারে।
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BN..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:apnar@email.com"

# রোজকার মনে করিয়ে দেওয়ার cron যেন বাইরের কেউ চালাতে না পারে
CRON_SECRET="lomba-akta-gopon-lekha"
